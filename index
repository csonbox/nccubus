<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>政大公車全自動導覽</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;700;900&display=swap');
        
        body {
            background-color: #fcfcfd;
            font-family: 'Noto Sans TC', -apple-system, sans-serif;
            overscroll-behavior-y: contain;
            color: #2d3748;
        }

        /* 統一的框架風格 */
        .ui-frame {
            border: 1.5px solid #1a202c;
            border-radius: 0.75rem;
            background: #ffffff;
            transition: all 0.2s ease;
        }

        /* 柔和的色彩系統 */
        .color-r2 { color: #4a69bd; } 
        .color-r3 { color: #527a5e; } 
        
        .border-r2 { border-left: 6px solid #4a69bd; }
        .border-r3 { border-left: 6px solid #527a5e; }
        .border-holi { border-left: 6px solid #718096; }

        /* 時刻表路線選擇框 */
        .route-frame {
            border: 1.5px solid #e2e8f0;
            color: #718096;
            font-weight: 700;
            text-align: center;
            padding: 0.85rem;
            border-radius: 0.75rem;
            transition: all 0.2s ease;
        }
        .route-frame.active {
            border-color: #1a202c;
            background-color: #1a202c;
            color: #ffffff;
        }

        /* 狀態標籤 */
        .badge-pill {
            background: #f7fafc;
            color: #1a202c;
            padding: 4px 12px;
            border-radius: 0.5rem;
            border: 1.2px solid #1a202c;
            font-size: 0.8rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .badge-pill .min-val { color: #4a69bd; font-size: 1.05rem; }

        .status-past { opacity: 0.3; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        
        /* 懸浮按鈕 */
        .fab-btn {
            position: fixed;
            bottom: 2.5rem;
            right: 1.5rem;
            width: 3.5rem;
            height: 3.5rem;
            background: #1a202c;
            color: white;
            border-radius: 1.2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 12px 20px -5px rgba(0, 0, 0, 0.25);
            z-index: 100;
        }
    </style>
</head>
<body class="flex flex-col h-screen overflow-hidden">

    <!-- 頂部標頭 -->
    <header class="px-6 pt-12 pb-6 bg-white z-50 border-b border-slate-100">
        <div class="flex items-center gap-3">
            <h1 class="text-2xl font-black text-slate-800 tracking-tighter">NCCU BUS</h1>
            <span class="text-slate-200 text-3xl font-extralight mb-1">|</span>
            <div id="liveClock" class="text-2xl font-mono font-bold text-slate-500 tracking-tight">
                --:--:--
            </div>
        </div>
        <p id="dateLabel" class="text-[10px] text-slate-400 font-bold uppercase tracking-[0.25em] mt-1.5 ml-0.5">Initializing Monitoring...</p>
    </header>

    <!-- 主內容區 -->
    <main class="flex-1 overflow-hidden relative">
        
        <!-- 分頁一：首頁 -->
        <section id="page-dynamics" class="h-full overflow-y-auto p-6 space-y-8 no-scrollbar">
            
            <!-- 區塊一：公車即時動態地圖 -->
            <div class="space-y-4">
                <h2 class="text-[11px] font-black text-slate-400 uppercase tracking-[0.2em] ml-1">公車即時動態地圖</h2>
                <div class="grid grid-cols-3 gap-3">
                    <a href="http://nccu.5284.com.tw/MQS/route.jsp?rid=16446" target="_blank" class="ui-frame py-3.5 text-center font-bold text-slate-700 active:bg-slate-50">1 路</a>
                    <a href="http://nccu.5284.com.tw/MQS/route.jsp?rid=16447" target="_blank" class="ui-frame py-3.5 text-center font-bold color-r2 active:bg-slate-50">2 路</a>
                    <a href="http://nccu.5284.com.tw/MQS/route.jsp?rid=16448" target="_blank" class="ui-frame py-3.5 text-center font-bold color-r3 active:bg-slate-50">3 路</a>
                </div>
            </div>

            <!-- 區塊二：最近發車預報 (核心大卡片) -->
            <div class="space-y-4">
                <h2 class="text-[11px] font-black text-slate-400 uppercase tracking-[0.2em] ml-1">智慧預報儀表板</h2>
                <div onclick="showPage('schedule')" class="bg-[#2d3436] text-white rounded-2xl p-7 shadow-xl cursor-pointer active:scale-[0.98] transition-all">
                    <div class="flex justify-between items-center mb-5">
                        <span class="text-[10px] font-bold opacity-40 tracking-[0.25em] uppercase italic">Next Shuttle</span>
                        <div class="flex items-center gap-2">
                            <span class="w-1.5 h-1.5 bg-emerald-400 rounded-full animate-pulse"></span>
                            <span class="text-[9px] font-bold text-emerald-400 uppercase tracking-widest">Active</span>
                        </div>
                    </div>
                    <div id="homeNextBus" class="text-3xl font-black tracking-tighter mb-2 italic decoration-slate-500">載入班次數據...</div>
                    <div id="homeNextCountdown" class="text-xl font-bold text-slate-300">--</div>
                    
                    <div class="flex items-center justify-between text-[9px] font-bold text-white/20 uppercase tracking-widest border-t border-white/5 mt-6 pt-4">
                        <span>點擊展開詳細時刻表</span>
                        <span class="opacity-40">VIEW ALL →</span>
                    </div>
                </div>
            </div>

            <!-- 區塊三：官方時刻表 -->
            <div class="space-y-4">
                <h2 class="text-[11px] font-black text-slate-400 uppercase tracking-[0.2em] ml-1">外部數據來源</h2>
                <a href="https://aff.nccu.edu.tw/PageDoc/Detail?fid=8612&id=3945" target="_blank" class="ui-frame w-full p-5 flex justify-between items-center bg-white active:bg-slate-50">
                    <div>
                        <div class="text-base font-black text-slate-800">政大總務處原始時刻表</div>
                        <p class="text-[10px] text-slate-400 font-bold uppercase mt-1 tracking-wider">Official Web Portal</p>
                    </div>
                    <div class="text-slate-300 text-xl">🔗</div>
                </a>
            </div>

            <div class="h-24"></div>
        </section>

        <!-- 分頁二：智慧時刻表 -->
        <section id="page-schedule" class="hidden h-full flex flex-col">
            <!-- 返回與標題 -->
            <div class="px-6 py-5 flex justify-between items-center bg-white border-b border-slate-100">
                <button onclick="showPage('dynamics')" class="text-slate-800 text-sm font-black flex items-center gap-2">
                    <span class="text-lg">←</span> <span>返回首頁</span>
                </button>
                <span class="text-[10px] font-bold text-slate-300 uppercase tracking-widest italic">Timetable</span>
            </div>
            
            <!-- 路線選擇 -->
            <div id="routeSelectors" class="px-6 py-4 grid grid-cols-2 gap-4">
                <button onclick="toggleRoute('R2')" id="btn-R2" class="route-frame active">2 路時刻</button>
                <button onclick="toggleRoute('R3')" id="btn-R3" class="route-frame active">3 路時刻</button>
            </div>

            <div id="scheduleList" class="flex-1 overflow-y-auto px-6 pb-32 space-y-4 no-scrollbar scroll-smooth">
                <!-- JS Render -->
            </div>

            <button onclick="scrollToCurrent()" class="fab-btn active:scale-90 transition-transform">🎯</button>
        </section>

    </main>

    <script>
        /**
         * 數據修正: 2路 14:40 已改為 14:50
         */
        const schedulesWeekday = {
            R2: ["07:30", "07:50", "08:20", "08:40", "09:20", "09:50", "10:20", "10:50", "11:20", "11:50", "12:20", "13:20", "13:50", "14:20", "14:50", "15:20", "15:50", "16:20", "16:50", "17:20", "17:50", "18:10", "19:10", "20:10", "21:30"],
            R3_Fixed: ["08:10", "09:30", "10:10", "10:30", "11:10", "11:30", "12:10", "13:10", "13:30", "14:10", "14:30", "15:10", "15:30", "16:30", "17:10", "17:30"]
        };

        const scheduleHoliday = ["08:00", "08:20", "08:40", "09:00", "09:20", "09:40", "10:00", "10:20", "10:40", "11:00", "11:20", "12:00", "12:20", "12:40", "13:00", "13:20", "13:40", "14:00", "14:20", "14:40", "15:00", "15:20", "15:40", "16:00", "16:20", "16:40", "17:00", "17:20", "18:00", "18:20", "18:40", "19:00", "19:20", "19:40", "20:00", "20:20", "20:40", "21:00", "21:20", "21:40", "22:00", "22:15", "22:30", "22:45", "23:00"];

        // 2025 假日清單
        const staticHolidays = ["2025-01-01", "2025-01-25", "2025-01-26", "2025-01-27", "2025-01-28", "2025-01-29", "2025-01-30", "2025-01-31", "2025-02-01", "2025-02-02", "2025-02-28", "2025-04-03", "2025-04-04", "2025-05-31", "2025-10-06", "2025-10-10"];

        let currentView = 'dynamics';
        let selectedRoutes = ['R2', 'R3'];
        const BUFFER_MINS = 5;

        function checkIfHoliday() {
            const now = new Date();
            const day = now.getDay();
            const dateStr = now.getFullYear() + "-" + (now.getMonth() + 1).toString().padStart(2, '0') + "-" + now.getDate().toString().padStart(2, '0');
            return (day === 0 || day === 6 || staticHolidays.includes(dateStr));
        }

        function showPage(pageId) {
            currentView = pageId;
            document.getElementById('page-dynamics').classList.toggle('hidden', pageId !== 'dynamics');
            document.getElementById('page-schedule').classList.toggle('hidden', pageId !== 'schedule');
            if (pageId === 'schedule') {
                if (checkIfHoliday()) document.getElementById('routeSelectors').classList.add('hidden');
                else document.getElementById('routeSelectors').classList.remove('hidden');
                renderSchedule();
                scrollToCurrent();
            }
        }

        function toggleRoute(rid) {
            if (selectedRoutes.includes(rid)) {
                if (selectedRoutes.length > 1) selectedRoutes = selectedRoutes.filter(r => r !== rid);
            } else {
                selectedRoutes.push(rid);
            }
            updateRouteSelectorUI();
            renderSchedule();
        }

        function updateRouteSelectorUI() {
            ['R2', 'R3'].forEach(rid => {
                const btn = document.getElementById(`btn-${rid}`);
                btn.className = selectedRoutes.includes(rid) ? "route-frame active" : "route-frame inactive";
            });
        }

        function updateClock() {
            const now = new Date();
            document.getElementById('liveClock').innerText = now.toTimeString().split(' ')[0];
            updateForecast();
            const isHoli = checkIfHoliday();
            document.getElementById('dateLabel').innerText = isHoli ? "Holiday monitoring active" : "Weekday monitoring active";
        }

        function updateForecast() {
            const now = new Date();
            const nowTotal = now.getHours() * 60 + now.getMinutes();
            const isHoli = checkIfHoliday();
            const homeDisplay = document.getElementById('homeNextBus');
            const homeCountdown = document.getElementById('homeNextCountdown');

            let winner = null;
            if (isHoli) {
                for (let t of scheduleHoliday) {
                    const [h, m] = t.split(':').map(Number);
                    if (h * 60 + m > nowTotal) {
                        winner = { route: "假日公車", time: t, diff: (h * 60 + m) - nowTotal };
                        break;
                    }
                }
            } else {
                if (nowTotal >= 1080 && nowTotal < 1380) {
                    homeDisplay.innerText = `3 路 ‣ 現場發車`;
                    homeCountdown.innerText = `目前為班距運行時段 (至 23:00)`;
                    return;
                }
                let nextR2 = null;
                for (let t of schedulesWeekday.R2) {
                    const [h, m] = t.split(':').map(Number);
                    if (h * 60 + m > nowTotal) { nextR2 = { route: "2 路", time: t, diff: (h * 60 + m) - nowTotal }; break; }
                }
                let nextR3 = null;
                for (let t of schedulesWeekday.R3_Fixed) {
                    const [h, m] = t.split(':').map(Number);
                    if (h * 60 + m > nowTotal) { nextR3 = { route: "3 路", time: t, diff: (h * 60 + m) - nowTotal }; break; }
                }
                if (nextR2 && nextR3) winner = nextR2.diff <= nextR3.diff ? nextR2 : nextR3;
                else winner = nextR2 || nextR3;
            }

            if (winner) {
                homeDisplay.innerText = `${winner.route} ‣ ${winner.time}`;
                homeCountdown.innerText = `約 ${winner.diff} 分鐘後發車`;
            } else {
                homeDisplay.innerText = `今日服務已結束`;
                homeCountdown.innerText = `明早請參考首班車公告`;
            }
        }

        function renderSchedule() {
            const container = document.getElementById('scheduleList');
            const now = new Date();
            const nowTotal = now.getHours() * 60 + now.getMinutes();
            const isHoli = checkIfHoliday();
            
            container.innerHTML = '';
            let merged = [];

            if (isHoli) {
                merged = scheduleHoliday.map(t => ({ time: t, route: "假日公車", type: 'fixed', class: 'border-holi' }));
            } else {
                if (selectedRoutes.includes('R2')) schedulesWeekday.R2.forEach(t => merged.push({ time: t, route: "2 路", type: 'fixed', class: 'border-r2', rClass: 'color-r2' }));
                if (selectedRoutes.includes('R3')) {
                    schedulesWeekday.R3_Fixed.forEach(t => merged.push({ time: t, route: "3 路", type: 'fixed', class: 'border-r3', rClass: 'color-r3' }));
                    merged.push({ time: "18:00", route: "3 路", type: 'interval', class: 'border-r3', rClass: 'color-r3' });
                }
                merged.sort((a, b) => {
                    const [ha, ma] = a.time.split(':').map(Number);
                    const [hb, mb] = b.time.split(':').map(Number);
                    return (ha * 60 + ma) - (hb * 60 + mb);
                });
            }

            let foundNext = false;
            merged.forEach((item) => {
                const [h, m] = item.time.split(':').map(Number);
                const busTotal = h * 60 + m;
                const diff = busTotal - nowTotal;
                const card = document.createElement('div');
                card.className = `ui-frame p-6 flex flex-col gap-1 shadow-sm transition-all duration-300 ${item.class}`;
                
                let badge = '';
                if (item.type === 'interval') {
                    const isInterval = (nowTotal >= 1080 && nowTotal < 1380);
                    if (isInterval) { card.classList.add('ring-2', 'ring-slate-100'); card.id = "focus-target"; badge = `<div class="badge-pill">現場發車</div>`; }
                    else if (nowTotal >= 1380) card.classList.add('status-past');
                    card.innerHTML = `<div class="flex justify-between items-center"><div class="text-2xl font-black text-slate-800 font-mono italic">18:00-23:00</div>${badge}</div><div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">${item.route} ‣ 班距運行時段</div>`;
                } else {
                    if (diff < -BUFFER_MINS) card.classList.add('status-past');
                    else if (diff <= 0 && diff >= -BUFFER_MINS) { card.classList.add('ring-2', 'ring-slate-100'); card.id = "focus-target"; badge = `<div class="badge-pill" style="border-color:#e67e22; color:#e67e22;">剛發車</div>`; }
                    else if (diff > 0 && !foundNext) { foundNext = true; card.id = "focus-target"; badge = `<div class="badge-pill">剩 <span class="min-val">${diff}</span> 分</div>`; }
                    card.innerHTML = `<div class="flex justify-between items-center"><div class="text-3xl font-black font-mono text-slate-800">${item.time}</div>${badge}</div><div class="text-[10px] font-bold ${item.rClass || ''} uppercase tracking-widest">${item.route} ‣ 預定：行政大樓</div>`;
                }
                container.appendChild(card);
            });
        }

        function scrollToCurrent() { setTimeout(() => { const target = document.getElementById('focus-target'); if (target) target.scrollIntoView({ behavior: 'smooth', block: 'center' }); }, 100); }
        updateClock(); setInterval(updateClock, 1000); setInterval(() => { if(currentView === 'schedule') renderSchedule(); }, 30000); showPage('dynamics');
    </script>
</body>
</html>
